#!/bin/bash
# ============================================================
# 印章对比工具 — macOS 双击启动器 (BI4IWN · 李劲松)
#
# 双击此文件即可运行：macOS 会将 .command 扩展名自动用
# 「终端 (Terminal)」打开，无需任何额外设置。
# 实际逻辑复用同目录下的 launcher.sh（环境检测 / 依赖安装 /
# 服务启动 / 打开浏览器）。
#
# 若双击后提示"无法打开"（Gatekeeper 提示），请在"系统设置 →
# 隐私与安全性"中允许，或在终端执行一次：
#   chmod +x "启动印章对比工具.command"
# ============================================================

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

exec ./launcher.sh "$@"
