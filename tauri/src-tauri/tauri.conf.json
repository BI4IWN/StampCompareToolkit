{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "印章比对工具",
  "version": "3.6.33",
  "identifier": "com.bi4iwn.stampcompare",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "印章对比工具 v3.6.33",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "url": "http://127.0.0.1:18970/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "models/*"
    ]
  }
}
